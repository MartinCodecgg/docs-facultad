                  "\" con nota " + nota + " creada correctamente.";
                document.getElementById("input-materia").value = "";
                document.getElementById("input-nota").value = "";
              } else {
                status.style.color = "#c0392b";
                status.textContent = "⚠️ Respuesta inesperada: HTTP " +
